# npm run dev + demo: local per-player saves in ignored .local-data/ (automatic Daniel965 sandbox).
# npm run start + demo: ephemeral memory. Never enable demo in production.
DEMO_MODE=true
PORT=3001
# Required when DEMO_MODE=false:
MONGO_URI=mongodb://127.0.0.1:27017/vanthuong
REDIS_URL=redis://127.0.0.1:6379
FIREBASE_PROJECT_ID=
# Use Firebase service-account ADC / GOOGLE_APPLICATION_CREDENTIALS outside the repository.
# Optional: pin admin to a single Firebase UID in addition to its admin custom claim.
ADMIN_FIREBASE_UID=
# Optional Firebase web app config for normal Google and email/password login:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
